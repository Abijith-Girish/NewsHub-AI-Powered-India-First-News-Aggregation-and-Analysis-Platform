# The frontend only needs these for non-local development hosts.
# Copy to frontend/.env.local when needed; never put API keys here — all secrets
# belong in backend/.env and are read server-side only.

# Extra hostnames allowed by the Vite dev server (comma separated).
# VITE_ALLOWED_HOSTS=preview.example.com

# Where the Vite dev server proxies /api requests.
# VITE_API_PROXY=http://127.0.0.1:8000
