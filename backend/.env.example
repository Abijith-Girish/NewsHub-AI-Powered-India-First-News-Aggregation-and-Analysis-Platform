# ---------------------------------------------------------------------------
# NewsHub backend configuration
# Copy this file to backend/.env and adjust the values you need.
# Never commit .env or any real API key.
# ---------------------------------------------------------------------------

# Django core
DJANGO_SECRET_KEY=change-me-in-production-use-a-long-random-string
DJANGO_DEBUG=true
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_COOKIES=false
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver
# Comma separated origins allowed to call the API directly (Vite dev server).
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# News providers. RSS aggregation works with no keys at all.
# ---------------------------------------------------------------------------
# Optional: https://newsapi.org/register
NEWSAPI_KEY=
# Optional: https://gnews.io/
GNEWS_API_KEY=

# Network behaviour
NEWS_FETCH_TIMEOUT=8
NEWS_CACHE_TTL=600
NEWS_MAX_ARTICLES_PER_FEED=35
NEWS_MAX_FEEDS=50
NEWS_ENABLE_LIVE_FETCH=true

# ---------------------------------------------------------------------------
# AI providers for summaries, daily briefings, fact-check explanations,
# and optional LLM translation fallback. Gemini is primary; Groq is fallback.
# Get keys from https://aistudio.google.com/api-keys and https://console.groq.com/keys
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT=18

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT=18

# On-demand extraction from publicly accessible publisher article pages.
# NewsHub respects robots.txt, paywalls, login walls, CAPTCHAs and access restrictions.
# Extracted text is held in cache temporarily and is not persisted to the Article table.
ARTICLE_EXTRACTION_ENABLED=true
ARTICLE_EXTRACTION_RESPECT_ROBOTS=true
ARTICLE_EXTRACTION_TIMEOUT=9
ARTICLE_EXTRACTION_MAX_BYTES=3145728
ARTICLE_EXTRACTION_CACHE_TTL=21600
ARTICLE_EXTRACTION_FAILURE_TTL=600

# Optional legacy OpenAI-compatible provider. It is not called after Gemini/Groq
# failures unless LLM_ENABLE_LEGACY_FALLBACK=true.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=25
LLM_ENABLE_LEGACY_FALLBACK=false

# Production database (set DB_ENGINE=postgresql and fill these values).
DB_ENGINE=sqlite
DB_NAME=newshub
DB_USER=newshub
DB_PASSWORD=change-this-password
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# GEMINI_API_KEY and/or GROQ_API_KEY enable AI summaries, briefings, explanations and optional translation fallback.

# Indian-language translation. Sarvam supports Hindi, Malayalam, Tamil, Telugu and Kannada.
# Create an API key at https://dashboard.sarvam.ai/ and keep it server-side.
TRANSLATION_API_URL=
TRANSLATION_API_KEY=
SARVAM_API_KEY=
SARVAM_TRANSLATE_API_URL=https://api.sarvam.ai/translate
TRANSLATION_TIMEOUT=25
